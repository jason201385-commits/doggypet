{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DoggyPet",
  "version": "0.1.0",
  "identifier": "com.easyknowai.doggypet",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "狗狗桌寵",
        "width": 190,
        "height": 210,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-TW"
      }
    }
  }
}